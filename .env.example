# Plantilla para el archivo .env del EC2 (~/proyectoFinal/.env).
# Copiar:  cp .env.example .env   y completar con los valores reales.
# .env NO se commitea y los scripts de deploy lo conservan entre despliegues.

# PostgreSQL ( obligatorio: la app no arranca sin estos 3 valores )
DB_URL=jdbc:postgresql://HOST:5432/NOMBRE_DB
DB_USER=
DB_PASSWORD=

# Seguridad / CORS
GATEWAY_SECRET=
FRONTEND_ORIGIN=https://coffee-flower-frontend.vercel.app

# AWS SNS / region
AWS_REGION=us-east-1
SNS_TOPIC_ARN=
AWS_SNS_TOPIC_ARN=

# Mail del informe (antes hardcoded en application.properties)
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
INFORME_EMAIL_DESTINO=

# Kafka productor (el compose ya inyecta KAFKA_BOOTSTRAP_SERVERS=kafka:9092)
KAFKA_TOPIC=pagos
KAFKA_ORIGEN=api
